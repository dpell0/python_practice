"""
Given a list of integers, return the number that appears most often.
"""
#solution 1
def mostFrequent(numbers):
    track = {}

    for i in numbers:
        if i in track:
            track[i] += 1
        else:
            track[i] = 1

    answer = numbers[0]

    for i in track:
        if track[i] > track[answer]:
            answer = i

    return answer


#test cases
print(mostFrequent([3, 1, 3, 2, 3, 2]))  # Expected: 3
print(mostFrequent([4, 2, 2, 4]))        # Expected: 4
print(mostFrequent([2, 4, 4, 2]))        # Expected: 2
print(mostFrequent([7, 8, 9]))           # Expected: 7
print(mostFrequent([-1, -1, 2]))        # Expected: -1
print(mostFrequent([0, 1, 0]))           # Expected: 0
print(mostFrequent([5]))                # Expected: 5